diff --git a/public/customer/assets/css/customer-variables.css b/public/customer/assets/css/customer-variables.css
new file mode 100644
index 0000000..53bbff9
--- /dev/null
+++ b/public/customer/assets/css/customer-variables.css
@@ -0,0 +1,23 @@
+/* Customer design tokens */
+:root {
+    --color-primary-dark: #0B3A82;
+    --color-primary: #1357C8;
+    --color-primary-light: #DBEAFE;
+    --color-background: #F8FAFC;
+    --color-card: #FFFFFF;
+    --color-text: #0F172A;
+    --color-text-secondary: #64748B;
+    --color-border: #E2E8F0;
+    --color-success: #0F8A65;
+    --color-success-soft: #DCFCE7;
+    --color-warning: #B45309;
+    --color-warning-soft: #FEF3C7;
+    --color-error: #B42318;
+    --color-error-soft: #FEE2E2;
+    --color-neutral-soft: #F1F5F9;
+    --radius-card: 16px;
+    --radius-control: 10px;
+    --shadow-card: 0 8px 24px rgba(15, 23, 42, 0.06);
+    --sidebar-width: 272px;
+    --transition-fast: 180ms ease;
+}
diff --git a/public/customer/assets/css/customer-vehicles.css b/public/customer/assets/css/customer-vehicles.css
new file mode 100644
index 0000000..7f3ffac
--- /dev/null
+++ b/public/customer/assets/css/customer-vehicles.css
@@ -0,0 +1,486 @@
+/* Customer vehicle catalogue and detail views */
+.vehicle-filters {
+    display: grid;
+    gap: 1rem;
+}
+
+.vehicle-filters__heading,
+.vehicle-results-heading,
+.vehicle-card__heading,
+.vehicle-card__footer,
+.vehicle-detail-overview__heading,
+.vehicle-trust-row {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 1rem;
+}
+
+.vehicle-filters__heading h2,
+.vehicle-results-heading h2,
+.vehicle-card__heading h2,
+.vehicle-detail-overview__heading h2 {
+    margin: 0;
+}
+
+.vehicle-filters .alert ul {
+    margin: 0.35rem 0 0;
+    padding-left: 1.2rem;
+}
+
+.vehicle-filter-form {
+    display: grid;
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+    gap: 0.9rem;
+}
+
+.vehicle-filter-form__keyword {
+    grid-column: span 2;
+}
+
+.vehicle-filter-form__actions {
+    display: flex;
+    align-items: flex-end;
+}
+
+.vehicle-filter-form__actions .button {
+    width: 100%;
+}
+
+.vehicle-active-filters {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 0.45rem;
+    padding-top: 0.9rem;
+    border-top: 1px solid var(--color-border);
+    color: var(--color-text-secondary);
+    font-size: 0.76rem;
+}
+
+.vehicle-active-filters span {
+    padding: 0.3rem 0.55rem;
+    color: var(--color-primary-dark);
+    border-radius: 999px;
+    background: var(--color-primary-light);
+    font-weight: 650;
+}
+
+.vehicle-results-heading {
+    margin-bottom: 1rem;
+}
+
+.vehicle-results-heading > p {
+    margin: 0;
+    color: var(--color-text-secondary);
+    font-size: 0.82rem;
+}
+
+.vehicle-grid {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 1rem;
+}
+
+.vehicle-card {
+    display: flex;
+    min-width: 0;
+    flex-direction: column;
+    overflow: hidden;
+    border: 1px solid var(--color-border);
+    border-radius: var(--radius-card);
+    background: var(--color-card);
+    box-shadow: var(--shadow-card);
+}
+
+.vehicle-card__visual {
+    display: grid;
+    min-height: 10.5rem;
+    place-items: center;
+    align-content: center;
+    gap: 0.65rem;
+    color: var(--color-primary);
+    background: linear-gradient(145deg, #EFF6FF, #DBEAFE);
+}
+
+.vehicle-card__visual img {
+    display: block;
+    width: 100%;
+    height: 13rem;
+    object-fit: cover;
+}
+
+.vehicle-card__visual .icon {
+    width: 3.5rem;
+    height: 3.5rem;
+}
+
+.vehicle-card__visual span {
+    color: var(--color-text-secondary);
+    font-size: 0.75rem;
+}
+
+.vehicle-card__body {
+    display: flex;
+    height: 100%;
+    flex-direction: column;
+    gap: 1rem;
+    padding: 1.1rem;
+}
+
+.vehicle-card__heading {
+    align-items: flex-start;
+}
+
+.vehicle-card__heading h2 {
+    font-size: 1.1rem;
+}
+
+.vehicle-card__rating {
+    display: flex;
+    align-items: center;
+    gap: 0.25rem;
+    margin: 0.4rem 0 0;
+    color: #667085;
+    font-size: 0.73rem;
+}
+
+.vehicle-card__rating > span:first-child {
+    display: inline-flex;
+    gap: 0.08rem;
+    color: #d0d5dd;
+    font-size: 0.92rem;
+    letter-spacing: 0;
+}
+
+.vehicle-card__rating .is-filled {
+    color: #fdb022;
+}
+
+.vehicle-card__rating strong {
+    color: #344054;
+    font-size: 0.75rem;
+}
+
+.vehicle-card__rating small {
+    color: #98a2b3;
+    font-size: 0.7rem;
+}
+
+.vehicle-card__rating--empty {
+    color: #98a2b3;
+}
+
+.vehicle-card__rating--empty > span:first-child {
+    color: #d0d5dd;
+}
+
+.vehicle-card__meta {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.4rem;
+    margin: 0;
+    padding: 0;
+    list-style: none;
+}
+
+.vehicle-card__meta li {
+    padding: 0.3rem 0.5rem;
+    color: #475569;
+    border-radius: 999px;
+    background: var(--color-neutral-soft);
+    font-size: 0.72rem;
+}
+
+.vehicle-card__price-row,
+.vehicle-detail-prices {
+    display: grid;
+    gap: 0.55rem;
+}
+
+.vehicle-price {
+    display: flex;
+    align-items: baseline;
+    gap: 0.4rem;
+    margin: 0;
+}
+
+.vehicle-price strong {
+    color: var(--color-text);
+    font-size: 1.05rem;
+}
+
+.vehicle-price span {
+    color: var(--color-text-secondary);
+    font-size: 0.75rem;
+}
+
+.vehicle-price--secondary strong {
+    font-size: 0.9rem;
+}
+
+.vehicle-card__footer {
+    margin-top: auto;
+    padding-top: 0.85rem;
+    border-top: 1px solid var(--color-border);
+}
+
+.vehicle-card__footer .button .icon {
