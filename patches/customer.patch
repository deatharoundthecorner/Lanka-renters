+<?php
+
+require_once dirname(__DIR__) . '/helpers/Database.php';
+
+/**
+ * Read-only vehicle catalogue queries for authenticated Customers.
+ */
+class CustomerVehicle
+{
+    private ?PDO $db;
+
+    public function __construct(?PDO $db = null)
+    {
+        $this->db = $db;
+    }
+
+    public function searchVehicles(array $filters, string $sort, int $limit, int $offset): array
+    {
+        $params = [];
+        $where = $this->buildWhere($filters, $params);
+        $orderBy = $this->sortClause($sort, $filters);
+
+        $sql = "SELECT
+                    v.id,
+                    v.make,
+                    v.model,
+                    v.year,
+                    v.license_plate,
+                    v.vehicle_type,
+                    v.transmission,
+                    v.fuel_type,
+                    v.seating_capacity,
+                    v.location,
+                    v.air_conditioning,
+                    v.price_per_day,
+                    v.monthly_rental_price,
+                    v.refundable_key_money,
+                    v.mileage_limit_km,
+                    v.mileage_is_unlimited,
+                    v.additional_mileage_charge_per_km,
+                    v.price_with_driver_per_day,
+                    v.image_url,
+                    v.status,
+                    v.verification_status,
+                    v.created_at,
+                    u.name AS owner_name,
+                    COALESCE(document_summary.approved_document_count, 0) AS approved_document_count,
+                    COALESCE(rating_summary.average_rating, 0) AS average_rating,
+                    COALESCE(rating_summary.review_count, 0) AS review_count
+                FROM vehicles v
+                INNER JOIN vehicle_owners vo ON vo.id = v.owner_id
+                INNER JOIN users u ON u.id = vo.user_id
+                LEFT JOIN (
+                    SELECT vehicle_id, COUNT(*) AS approved_document_count
+                    FROM vehicle_documents
+                    WHERE verification_status = 'approved'
+                    GROUP BY vehicle_id
+                ) document_summary ON document_summary.vehicle_id = v.id
+                LEFT JOIN (
+                    SELECT vehicle_id, AVG(vehicle_rating) AS average_rating, COUNT(*) AS review_count
+                    FROM ratings_reviews
+                    WHERE vehicle_rating IS NOT NULL
+                    GROUP BY vehicle_id
+                ) rating_summary ON rating_summary.vehicle_id = v.id
+                {$where}
+                ORDER BY {$orderBy}
+                LIMIT :result_limit OFFSET :result_offset";
+
+        $statement = $this->connection()->prepare($sql);
+        $this->bindValues($statement, $params);
+        $statement->bindValue(':result_limit', $limit, PDO::PARAM_INT);
+        $statement->bindValue(':result_offset', $offset, PDO::PARAM_INT);
+        $statement->execute();
+
+        return $statement->fetchAll();
+    }
+
+    public function countVehicles(array $filters): int
