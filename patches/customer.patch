+.driver-change-page__form select, .driver-change-page__form textarea { width: 100%; border: 1px solid #dbe5f2; border-radius: 10px; color: #334155; font-family: inherit; font-size: .95rem; }
+.driver-change-page__form select { min-height: 43px; padding: 0 12px; background: #fff; }
+.driver-change-page__form textarea { min-height: 96px; padding: 12px; resize: vertical; }
+.driver-change-page__form .button { justify-self: start; min-height: 39px; padding-inline: 14px; }
+.driver-change-page__form .form-hint { margin: -4px 0 0; }
+.driver-change-page__history { padding-bottom: 18px; }
+.driver-change-page__table-wrap { overflow-x: auto; margin-top: 18px; border: 1px solid #dee6f0; border-radius: 10px; }
+.driver-change-page__history table { width: 100%; min-width: 610px; border-collapse: collapse; color: #172b4d; font-family: inherit; font-size: .88rem; }
+.driver-change-page__history th { padding: 12px 15px; background: #f4f7fb; color: #536b8c; font-size: .75rem; letter-spacing: .02em; text-align: left; text-transform: uppercase; }
+.driver-change-page__history td { padding: 14px 15px; border-top: 1px solid #dfe7f1; }
+.driver-change-page__history tbody tr:nth-child(even) { background: #fafcff; }
+.driver-change-page__pending { display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border: 1px solid #b7d1ff; border-radius: 999px; background: #eff6ff; color: #2563c5; font-family: Arial, sans-serif; font-size: .78rem; }
+.driver-change-page__empty { color: #667085; font-family: Arial, sans-serif; font-size: .88rem; text-align: center; }
+
+/* Customer confirmation for the with-driver pickup handover. */
+.pickup-status-page { display: grid; gap: 18px; max-width: 1080px; }
+.pickup-status-card { padding: 24px; border: 1px solid #7ee9e2; border-radius: 13px; background: #f7fcff; box-shadow: 0 3px 10px rgba(16, 24, 40, .05); }
+.pickup-status-card__heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
+.pickup-status-card__heading h2 { margin: 0; font-size: 1.15rem; }
+.pickup-status-card__heading .eyebrow { margin: 0 0 4px; }
+.pickup-status-card__meta { margin: 8px 0 16px; color: #52627a; font-size: .9rem; }
+.pickup-timeline { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
+.pickup-timeline__item { position: relative; display: grid; grid-template-columns: 34px 1fr; min-height: 45px; color: #60728d; }
+.pickup-timeline__item:not(:last-child)::before { position: absolute; top: 31px; bottom: -1px; left: 16px; width: 1px; background: #c7d6e7; content: ''; }
+.pickup-timeline__item--complete:not(:last-child)::before { background: #36cfc2; }
+.pickup-timeline__marker { display: grid; width: 29px; height: 29px; place-items: center; border: 2px solid #c7d6e7; border-radius: 50%; background: #fff; color: #008d87; font-size: .78rem; font-weight: 900; }
+.pickup-timeline__item--complete { color: #123b55; }
+.pickup-timeline__item--complete .pickup-timeline__marker { border-color: #00a99d; }
+.pickup-timeline__item--current { color: #123b55; }
+.pickup-timeline__item--current .pickup-timeline__marker { border-color: #008d87; box-shadow: inset 0 0 0 7px #fff, inset 0 0 0 10px #00a99d; }
+.pickup-timeline__item strong { display: block; padding-top: 5px; font-size: .94rem; }
+.pickup-timeline__pending { display: inline-block; margin-top: 5px; padding: 2px 7px; border: 1px solid #85e9df; border-radius: 4px; background: #cffaf3; color: #087c76; font-size: .68rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
+.pickup-status-card__action { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 18px; padding-top: 16px; border-top: 1px solid #ccebe9; }
+.pickup-status-card__action p, .pickup-status-card__waiting, .pickup-status-card__complete { margin: 0; color: #52627a; font-size: .9rem; }
+.pickup-status-card__complete { margin-top: 18px; color: #087c76; font-weight: 700; }
+.pickup-status-card__waiting { margin-top: 18px; }
+
+@media (max-width: 900px) {
+    .feature-detail-grid,
+    .chat-layout {
+        grid-template-columns: 1fr;
+    }
+}
+
+@media (max-width: 600px) {
+    .feature-list-card,
+    .feature-toolbar {
+        align-items: stretch;
+        flex-direction: column;
+    }
+
+    .feature-list-card__actions,
+    .stack-actions {
+        align-items: stretch;
+    }
+
+    .feature-detail-list {
+        grid-template-columns: 1fr;
+    }
+
+    .feature-detail-list__wide {
+        grid-column: auto;
+    }
+
+    .verification-card__header,
+    .verification-row {
+        align-items: flex-start;
+        flex-wrap: wrap;
+    }
+
+    .verification-row__actions {
+        width: 100%;
+        margin-left: 3rem;
+        justify-content: flex-start;
+    }
+
+    .feature-filter select,
+    .feature-filter .button,
+    .feature-toolbar form,
+    .feature-toolbar .button {
+        width: 100%;
+    }
+
+    .message-bubble {
+        max-width: 94%;
+    }
+
+    .incident-demo__topbar {
+        align-items: flex-start;
+        flex-direction: column;
+    }
+
+    .incident-demo__verify {
+        width: 100%;
+    }
+
+    .incident-demo__choices,
+    .incident-demo__upload-row {
+        align-items: stretch;
+        flex-direction: column;
+    }
+
+    .review-demo__booking-top,
+    .review-demo__booking-details,
+    .review-demo__form-heading { align-items: flex-start; flex-direction: column; }
+
+    .review-demo__driver { padding-left: 0; border-left: 0; }
