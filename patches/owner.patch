diff --git a/app/controllers/OwnerBookingController.php b/app/controllers/OwnerBookingController.php
new file mode 100644
index 0000000..4274551
--- /dev/null
+++ b/app/controllers/OwnerBookingController.php
@@ -0,0 +1,424 @@
+<?php
+
+require_once dirname(__DIR__) . '/helpers/AuthHelper.php';
+require_once dirname(__DIR__) . '/helpers/Database.php';
+require_once dirname(__DIR__) . '/models/VehicleOwner.php';
+
+/**
+ * Lanka Renters - Owner Booking Controller
+ * Retrieves bookings for vehicles owned by the authenticated vehicle owner.
+ * All queries enforce owner_id from session — never from client input.
+ */
+class OwnerBookingController {
+    private $db;
+    private $ownerModel;
+
+    public function __construct() {
+        $this->db         = Database::getInstance()->getConnection();
+        $this->ownerModel = new VehicleOwner();
+    }
+
+    /**
+     * Resolves authenticated owner profile from session.
+     */
+    private function getAuthenticatedOwner(): array {
+        AuthHelper::requireRole('owner');
+        $user = AuthHelper::getCurrentUser();
+        if (!$user) {
+            throw new Exception('Unauthorized access.');
+        }
+        $owner = $this->ownerModel->findByUserId($user['id']);
+        if (!$owner) {
+            throw new Exception('Vehicle owner profile not found.');
+        }
+        return ['user' => $user, 'owner' => $owner];
+    }
+
+    /**
+     * Retrieves all bookings for vehicles owned by the authenticated owner.
+     * Includes customer info and vehicle info for display.
+     */
+    public function getOwnerBookings(): array {
+        try {
+            $auth    = $this->getAuthenticatedOwner();
+            $ownerId = $auth['owner']['id'];
+
+            $stmt = $this->db->prepare("
+                SELECT
+                    b.id,
+                    b.status,
+                    b.booking_type,
+                    b.start_date,
+                    b.end_date,
+                    b.total_price,
+                    b.pickup_status,
+                    b.created_at,
+                    u.name  AS customer_name,
+                    u.phone AS customer_phone,
+                    u.email AS customer_email,
+                    v.make,
+                    v.model,
+                    v.license_plate,
+                    v.vehicle_type,
+                    (SELECT vi.status FROM vehicle_inspections vi WHERE vi.booking_id = b.id AND vi.inspection_type = 'pre_rental' ORDER BY vi.id DESC LIMIT 1) AS pre_rental_inspection_status,
+                    (SELECT vi.status FROM vehicle_inspections vi WHERE vi.booking_id = b.id AND vi.inspection_type = 'post_rental' ORDER BY vi.id DESC LIMIT 1) AS post_rental_inspection_status,
+                    (SELECT rr.id FROM return_requests rr WHERE rr.booking_id = b.id AND rr.status IN ('pending', 'approved') ORDER BY rr.id DESC LIMIT 1) AS return_request_id,
+                    (SELECT rr.proposed_return_at FROM return_requests rr WHERE rr.booking_id = b.id AND rr.status IN ('pending', 'approved') ORDER BY rr.id DESC LIMIT 1) AS proposed_return_at,
+                    (SELECT rr.customer_note FROM return_requests rr WHERE rr.booking_id = b.id AND rr.status IN ('pending', 'approved') ORDER BY rr.id DESC LIMIT 1) AS return_customer_note
+                FROM bookings b
+                JOIN vehicles  v ON b.vehicle_id  = v.id
+                JOIN customers c ON b.customer_id = c.id
+                JOIN users     u ON c.user_id     = u.id
+                WHERE v.owner_id = :owner_id
+                ORDER BY b.created_at DESC
+            ");
+            $stmt->execute(['owner_id' => (int)$ownerId]);
+            $bookings = $stmt->fetchAll(PDO::FETCH_ASSOC);
+
+            return ['success' => true, 'bookings' => $bookings, 'owner' => $auth['owner']];
+        } catch (Exception $e) {
+            return ['success' => false, 'error' => $e->getMessage(), 'bookings' => []];
+        }
+    }
+
+    /**
+     * Returns booking summary statistics for the authenticated owner.
+     */
+    public function getBookingSummary(): array {
+        try {
+            $auth    = $this->getAuthenticatedOwner();
+            $ownerId = $auth['owner']['id'];
+
+            $stmt = $this->db->prepare("
+                SELECT
+                    COUNT(*) AS total,
+                    SUM(CASE WHEN b.status = 'pending_approval' THEN 1 ELSE 0 END) AS pending_approval,
+                    SUM(CASE WHEN b.status = 'pending_payment'  THEN 1 ELSE 0 END) AS pending_payment,
+                    SUM(CASE WHEN b.status = 'confirmed'        THEN 1 ELSE 0 END) AS confirmed,
+                    SUM(CASE WHEN b.status = 'ongoing'          THEN 1 ELSE 0 END) AS ongoing,
+                    SUM(CASE WHEN b.status = 'completed'        THEN 1 ELSE 0 END) AS completed,
+                    SUM(CASE WHEN b.status = 'cancelled'        THEN 1 ELSE 0 END) AS cancelled
+                FROM bookings b
+                JOIN vehicles v ON b.vehicle_id = v.id
+                WHERE v.owner_id = :owner_id
+            ");
+            $stmt->execute(['owner_id' => (int)$ownerId]);
+            return $stmt->fetch(PDO::FETCH_ASSOC) ?: [];
+        } catch (Exception $e) {
+            return [];
+        }
+    }
+
+    /**
+     * Approves a pending_approval booking for a vehicle owned by the authenticated owner.
+     * Transitions status from 'pending_approval' to 'pending_payment'.
+     */
+    public function approveBooking(int $bookingId): array {
+        try {
+            $auth    = $this->getAuthenticatedOwner();
+            $ownerId = (int)$auth['owner']['id'];
+
+            $stmt = $this->db->prepare("
+                UPDATE bookings b
+                JOIN vehicles v ON b.vehicle_id = v.id
+                SET b.status = 'pending_payment'
+                WHERE b.id = :booking_id
+                  AND v.owner_id = :owner_id
+                  AND b.status = 'pending_approval'
+            ");
+            $stmt->execute([
+                'booking_id' => $bookingId,
+                'owner_id'   => $ownerId,
+            ]);
+
+            if ($stmt->rowCount() === 0) {
+                return [
+                    'success' => false,
+                    'error'   => 'Booking could not be approved. It may not exist, may not belong to your fleet, or is not awaiting approval.'
+                ];
+            }
+
+            return ['success' => true, 'message' => 'Booking #' . $bookingId . ' approved successfully. It is now awaiting customer payment.'];
+        } catch (Exception $e) {
+            return ['success' => false, 'error' => $e->getMessage()];
+        }
+    }
+
+    /**
+     * Rejects a pending_approval booking for a vehicle owned by the authenticated owner.
+     * Transitions status from 'pending_approval' to 'cancelled'.
+     */
+    public function rejectBooking(int $bookingId): array {
+        try {
+            $auth    = $this->getAuthenticatedOwner();
+            $ownerId = (int)$auth['owner']['id'];
+
+            $stmt = $this->db->prepare("
+                UPDATE bookings b
+                JOIN vehicles v ON b.vehicle_id = v.id
+                SET b.status = 'cancelled'
+                WHERE b.id = :booking_id
+                  AND v.owner_id = :owner_id
+                  AND b.status = 'pending_approval'
+            ");
+            $stmt->execute([
+                'booking_id' => $bookingId,
+                'owner_id'   => $ownerId,
+            ]);
+
+            if ($stmt->rowCount() === 0) {
+                return [
+                    'success' => false,
+                    'error'   => 'Booking could not be rejected. It may not exist, may not belong to your fleet, or is not awaiting approval.'
+                ];
+            }
+
+            return ['success' => true, 'message' => 'Booking #' . $bookingId . ' has been rejected and cancelled.'];
+        } catch (Exception $e) {
+            return ['success' => false, 'error' => $e->getMessage()];
+        }
+    }
+
+    /**
+     * Hands over a confirmed vehicle to the customer.
+     * Requires an authenticated owner, ownership of vehicle, confirmed booking status,
+     * and an existing passing pre-rental inspection.
+     * Transitions bookings.status from 'confirmed' to 'ongoing' and bookings.pickup_status to 'picked_up'.
+     * Inserts an audit record into pickup_tracking atomically.
+     */
+    public function handoverVehicle(int $bookingId): array {
+        try {
+            $auth    = $this->getAuthenticatedOwner();
+            $ownerId = (int)$auth['owner']['id'];
+            $userId  = (int)$auth['user']['id'];
+
+            $this->db->beginTransaction();
+
+            // 1. Verify booking exists, is confirmed, and vehicle belongs to owner
+            $stmt = $this->db->prepare("
+                SELECT b.id, b.status, b.pickup_status, b.vehicle_id, b.customer_id
+                FROM bookings b
+                JOIN vehicles v ON b.vehicle_id = v.id
+                WHERE b.id = :booking_id AND v.owner_id = :owner_id
+                FOR UPDATE
+            ");
+            $stmt->execute([
+                'booking_id' => $bookingId,
+                'owner_id'   => $ownerId,
+            ]);
+            $booking = $stmt->fetch(PDO::FETCH_ASSOC);
+
+            if (!$booking) {
+                $this->db->rollBack();
+                return [
+                    'success' => false,
+                    'error'   => 'Booking could not be found or does not belong to your vehicle fleet.'
+                ];
+            }
+
+            if ($booking['status'] !== 'confirmed') {
+                $this->db->rollBack();
+                return [
+                    'success' => false,
+                    'error'   => 'Vehicle handover can only be performed for confirmed bookings.'
+                ];
+            }
+
+            // 2. Verify passing pre-rental inspection exists
+            $inspStmt = $this->db->prepare("
+                SELECT id FROM vehicle_inspections
+                WHERE booking_id = :booking_id
+                  AND inspection_type = 'pre_rental'
+                  AND status = 'pass'
+                LIMIT 1
+            ");
+            $inspStmt->execute(['booking_id' => $bookingId]);
+            if (!$inspStmt->fetchColumn()) {
+                $this->db->rollBack();
+                return [
+                    'success' => false,
+                    'error'   => 'Cannot hand over vehicle. A passing pre-rental inspection must be recorded before handover.'
+                ];
+            }
+
+            // 3. Verify customer has an approved guarantor for rental liability
+            $guarStmt = $this->db->prepare("
+                SELECT verification_status
+                FROM customer_guarantors
+                WHERE customer_id = :customer_id
+                ORDER BY id DESC
+                LIMIT 1
+            ");
+            $guarStmt->execute(['customer_id' => (int)$booking['customer_id']]);
+            $guarStatus = $guarStmt->fetchColumn();
+            if ($guarStatus !== 'approved') {
+                $this->db->rollBack();
+                return [
+                    'success' => false,
+                    'error'   => 'Cannot hand over vehicle. Customer has not completed an approved guarantor verification required for rental liability.'
+                ];
+            }
+
+            // 3. Update bookings status to ongoing and pickup_status to picked_up
+            $updateStmt = $this->db->prepare("
+                UPDATE bookings
+                SET status = 'ongoing', pickup_status = 'picked_up'
+                WHERE id = :booking_id
+            ");
+            $updateStmt->execute(['booking_id' => $bookingId]);
+
+            // 4. Update vehicle status to rented
+            $updateVehStmt = $this->db->prepare("
+                UPDATE vehicles
+                SET status = 'rented'
+                WHERE id = :vehicle_id
+            ");
+            $updateVehStmt->execute(['vehicle_id' => (int)$booking['vehicle_id']]);
+
+            // 5. Insert pickup_tracking history record
+            $trackStmt = $this->db->prepare("
+                INSERT INTO pickup_tracking (booking_id, status, updated_by, driver_note)
+                VALUES (:booking_id, 'picked_up', :updated_by, :driver_note)
+            ");
+            $trackStmt->execute([
+                'booking_id'  => $bookingId,
+                'updated_by'  => $userId,
+                'driver_note' => 'Vehicle handed over to customer by owner.',
+            ]);
+
+            $this->db->commit();
+
+            return [
+                'success' => true,
+                'message' => 'Vehicle handed over successfully. Booking #' . $bookingId . ' is now active and ongoing.'
+            ];
+        } catch (Exception $e) {
+            if ($this->db->inTransaction()) {
+                $this->db->rollBack();
+            }
+            return ['success' => false, 'error' => $e->getMessage()];
+        }
+    }
+
+    /**
+     * Completes a rental upon return of the vehicle.
+     * Requires an authenticated owner, ownership of vehicle, ongoing booking status,
+     * and an existing post-rental inspection.
+     * Transitions bookings.status from 'ongoing' to 'completed' and bookings.pickup_status to 'dropped_off'.
+     * Inserts an audit record into pickup_tracking atomically.
+     */
+    public function completeRental(int $bookingId): array {
+        try {
+            $auth    = $this->getAuthenticatedOwner();
+            $ownerId = (int)$auth['owner']['id'];
+            $userId  = (int)$auth['user']['id'];
+
+            $this->db->beginTransaction();
+
+            // 1. Lock the booking row and verify ownership and ongoing status
+            $stmt = $this->db->prepare("
+                SELECT b.id, b.status, b.pickup_status, b.vehicle_id
+                FROM bookings b
+                JOIN vehicles v ON b.vehicle_id = v.id
+                WHERE b.id = :booking_id AND v.owner_id = :owner_id
+                FOR UPDATE
+            ");
+            $stmt->execute([
+                'booking_id' => $bookingId,
+                'owner_id'   => $ownerId,
+            ]);
+            $booking = $stmt->fetch(PDO::FETCH_ASSOC);
+
+            if (!$booking) {
+                $this->db->rollBack();
+                return [
+                    'success' => false,
+                    'error'   => 'Booking could not be found or does not belong to your vehicle fleet.'
+                ];
+            }
+
+            // 2. Reject non-ongoing statuses
+            if ($booking['status'] !== 'ongoing') {
+                $this->db->rollBack();
+                return [
+                    'success' => false,
+                    'error'   => 'Vehicle return can only be completed for ongoing bookings.'
+                ];
+            }
+
+            // 3. Verify a post-rental inspection exists
+            $inspStmt = $this->db->prepare("
+                SELECT id FROM vehicle_inspections
+                WHERE booking_id = :booking_id
+                  AND inspection_type = 'post_rental'
+                LIMIT 1
+            ");
+            $inspStmt->execute(['booking_id' => $bookingId]);
+            if (!$inspStmt->fetchColumn()) {
+                $this->db->rollBack();
+                return [
+                    'success' => false,
+                    'error'   => 'Cannot complete return. A post-rental inspection must be recorded before vehicle check-in.'
+                ];
+            }
+
+            // 4. Update bookings status to completed and pickup_status to dropped_off
+            $updateStmt = $this->db->prepare("
+                UPDATE bookings
+                SET status = 'completed',
+                    pickup_status = 'dropped_off'
+                WHERE id = :booking_id
+                  AND status = 'ongoing'
+            ");
+            $updateStmt->execute(['booking_id' => $bookingId]);
+
+            // 5. Restore vehicle status to available
+            $updateVehStmt = $this->db->prepare("
+                UPDATE vehicles
+                SET status = 'available'
+                WHERE id = :vehicle_id
+            ");
+            $updateVehStmt->execute(['vehicle_id' => (int)$booking['vehicle_id']]);
+
+            // 6. Insert pickup_tracking history record
+            $trackStmt = $this->db->prepare("
+                INSERT INTO pickup_tracking (
+                    booking_id,
+                    status,
+                    updated_by,
+                    driver_note
+                ) VALUES (
+                    :booking_id,
+                    'dropped_off',
+                    :updated_by,
+                    :driver_note
+                )
+            ");
+            $trackStmt->execute([
+                'booking_id'  => $bookingId,
+                'updated_by'  => $userId,
+                'driver_note' => 'Vehicle returned by customer and checked in by owner.',
+            ]);
+
+            // Close any active customer return request atomically with the existing check-in.
+            $returnStmt = $this->db->prepare(
+                "UPDATE return_requests
+                 SET status = 'completed', reviewed_by = :reviewed_by, reviewed_at = CURRENT_TIMESTAMP
+                 WHERE booking_id = :booking_id AND status IN ('pending', 'approved')"
+            );
+            $returnStmt->execute(['reviewed_by' => $userId, 'booking_id' => $bookingId]);
+
+            $this->db->commit();
+
+            return [
+                'success' => true,
+                'message' => 'Vehicle check-in completed successfully. Booking #' . $bookingId . ' is now marked as completed.'
+            ];
+        } catch (Exception $e) {
+            if ($this->db->inTransaction()) {
+                $this->db->rollBack();
+            }
+            return ['success' => false, 'error' => $e->getMessage()];
+        }
+    }
+}
diff --git a/app/controllers/OwnerChatController.php b/app/controllers/OwnerChatController.php
new file mode 100644
index 0000000..494041d
--- /dev/null
+++ b/app/controllers/OwnerChatController.php
@@ -0,0 +1,108 @@
+<?php
+require_once dirname(__DIR__) . '/helpers/AuthHelper.php';
+require_once dirname(__DIR__) . '/models/Chat.php';
+require_once dirname(__DIR__) . '/models/VehicleOwner.php';
+
+/**
+ * OwnerChatController
+ * Orchestrates Owner chat messaging and room authorization.
+ */
+class OwnerChatController {
+    private $chatModel;
+    private $ownerModel;
+
+    public function __construct() {
+        $this->chatModel = new Chat();
+        $this->ownerModel = new VehicleOwner();
+    }
+
+    private function getSessionContext() {
+        $user = AuthHelper::getCurrentUser();
+        if (!$user || $user['role'] !== 'owner') {
+            throw new Exception("Unauthorized. Owner login required.");
+        }
+        $owner = $this->ownerModel->findByUserId($user['id']);
+        if (!$owner) {
+            throw new Exception("Owner profile record not found.");
+        }
+        return [
+            'user_id'  => (int)$user['id'],
+            'owner_id' => (int)$owner['id'],
+            'name'     => $user['name']
+        ];
+    }
+
+    public function getChatData($activeRoomId = null) {
+        try {
+            $context = $this->getSessionContext();
+
+            $rooms = $this->chatModel->getUserRooms($context['user_id']);
+
+            $activeRoom = null;
+            $messages = [];
+
+            if (!empty($rooms)) {
+                $targetRoomId = $activeRoomId ? (int)$activeRoomId : (int)$rooms[0]['room_id'];
+                
+                // Verify owner is a participant in target room
+                if ($this->chatModel->isParticipant($targetRoomId, $context['user_id'])) {
+                    foreach ($rooms as $r) {
+                        if ((int)$r['room_id'] === $targetRoomId) {
+                            $activeRoom = $r;
+                            break;
+                        }
+                    }
+                    if ($activeRoom) {
+                        $messages = $this->chatModel->getMessages($targetRoomId);
+                        $this->chatModel->markMessagesAsRead($targetRoomId, $context['user_id']);
+                    }
+                }
+            }
+
+            return [
+                'success'    => true,
+                'rooms'      => $rooms,
+                'activeRoom' => $activeRoom,
+                'messages'   => $messages,
+                'userId'     => $context['user_id']
+            ];
+        } catch (Exception $e) {
+            return [
+                'success' => false,
+                'error'   => $e->getMessage()
+            ];
+        }
+    }
+
+    public function sendMessage() {
+        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
+            return null;
+        }
+
+        if (!AuthHelper::validateCsrfToken($_POST['csrf_token'] ?? '')) {
+            return ['success' => false, 'error' => 'Invalid security token. Please refresh and try again.'];
+        }
+
+        try {
+            $context = $this->getSessionContext();
+            $roomId = (int)($_POST['room_id'] ?? 0);
+            $messageText = trim($_POST['message_text'] ?? '');
+
+            if ($roomId <= 0 || empty($messageText)) {
+                return ['success' => false, 'error' => 'Message text cannot be empty.'];
+            }
+
+            if (!$this->chatModel->isParticipant($roomId, $context['user_id'])) {
+                return ['success' => false, 'error' => 'Access denied. You are not a participant in this chat.'];
+            }
+
+            $sent = $this->chatModel->sendMessage($roomId, $context['user_id'], $messageText);
+            return [
+                'success' => $sent,
+                'error'   => $sent ? '' : 'Failed to send message.'
+            ];
+        } catch (Exception $e) {
+            return ['success' => false, 'error' => $e->getMessage()];
+        }
+    }
+}
diff --git a/app/controllers/OwnerDriverChangeController.php b/app/controllers/OwnerDriverChangeController.php
new file mode 100644
index 0000000..de6c95f
--- /dev/null
+++ b/app/controllers/OwnerDriverChangeController.php
@@ -0,0 +1,110 @@
+<?php
+
+require_once dirname(__DIR__) . '/helpers/AuthHelper.php';
+require_once dirname(__DIR__) . '/models/DriverChangeRequest.php';
+require_once dirname(__DIR__) . '/models/VehicleOwner.php';
+
+/**
+ * Lanka Renters - Owner Driver Change Controller
+ * Coordinates viewing, approving, and rejecting customer driver change requests
+ * for vehicles owned by the authenticated vehicle owner.
+ */
+class OwnerDriverChangeController
+{
+    private DriverChangeRequest $requestModel;
+    private VehicleOwner $ownerModel;
+
+    public function __construct(
+        ?DriverChangeRequest $requestModel = null,
+        ?VehicleOwner $ownerModel = null
+    ) {
+        $this->requestModel = $requestModel ?? new DriverChangeRequest();
+        $this->ownerModel   = $ownerModel ?? new VehicleOwner();
+    }
+
+    public function getData(): array
+    {
+        AuthHelper::requireRole('owner');
+        $user = AuthHelper::getCurrentUser();
+        if (!$user) {
+            return ['success' => false, 'error' => 'Unauthorized'];
+        }
+
+        $owner = $this->ownerModel->findByUserId($user['id']);
+        if (!$owner) {
+            return ['success' => false, 'error' => 'Vehicle owner profile not found.'];
+        }
+
+        $ownerId = (int)$owner['id'];
+        $statusFilter = isset($_GET['status']) ? trim($_GET['status']) : null;
+        if (!in_array($statusFilter, ['pending', 'approved', 'rejected', 'cancelled'], true)) {
+            $statusFilter = null;
+        }
+
+        $requests = $this->requestModel->findByOwner($ownerId, $statusFilter);
+        $summary  = $this->requestModel->getSummaryByOwner($ownerId);
+
+        return [
+            'success'  => true,
+            'owner'    => $owner,
+            'requests' => $requests,
+            'summary'  => $summary,
+            'filter'   => $statusFilter,
+        ];
+    }
+
+    public function handleAction(array $post): ?array
+    {
+        if (strtoupper((string)($_SERVER['REQUEST_METHOD'] ?? 'GET')) !== 'POST') {
+            return null;
+        }
+
+        AuthHelper::requireRole('owner');
+        $user = AuthHelper::getCurrentUser();
+        if (!$user) {
+            return ['success' => false, 'error' => 'Unauthorized'];
+        }
+
+        if (!AuthHelper::validateCsrfToken($post['csrf_token'] ?? '')) {
+            return ['success' => false, 'error' => 'Security token invalid or expired. Please refresh and try again.'];
+        }
+
+        $owner = $this->ownerModel->findByUserId($user['id']);
+        if (!$owner) {
+            return ['success' => false, 'error' => 'Vehicle owner profile not found.'];
+        }
+
+        $ownerId        = (int)$owner['id'];
+        $reviewerUserId = (int)$user['id'];
+        $requestId      = (int)($post['request_id'] ?? 0);
+        $action         = trim((string)($post['action'] ?? ''));
+        $remarks        = trim((string)($post['remarks'] ?? ''));
+
+        if ($requestId <= 0) {
+            return ['success' => false, 'error' => 'Invalid driver change request ID.'];
+        }
+
+        try {
+            if ($action === 'approve') {
+                $this->requestModel->approve($requestId, $reviewerUserId, $ownerId, $remarks !== '' ? $remarks : null);
+                return [
+                    'success' => true,
+                    'message' => "Driver change request #{$requestId} has been approved. The new driver has been assigned to the booking.",
+                ];
+            } elseif ($action === 'reject') {
+                $this->requestModel->reject($requestId, $reviewerUserId, $ownerId, $remarks !== '' ? $remarks : null);
+                return [
+                    'success' => true,
+                    'message' => "Driver change request #{$requestId} has been rejected. The current driver remains assigned.",
+                ];
+            } else {
+                return ['success' => false, 'error' => 'Invalid action specified.'];
+            }
+        } catch (DriverChangeRequestException $e) {
+            return ['success' => false, 'error' => $e->getMessage()];
+        } catch (Throwable $e) {
+            error_log('Owner driver change review error: ' . $e->getMessage());
+            return ['success' => false, 'error' => 'Failed to process request. Please try again.'];
+        }
+    }
+}
diff --git a/app/controllers/OwnerDriverController.php b/app/controllers/OwnerDriverController.php
new file mode 100644
index 0000000..5202d21
--- /dev/null
+++ b/app/controllers/OwnerDriverController.php
@@ -0,0 +1,144 @@
+<?php
+
+require_once dirname(__DIR__) . '/helpers/AuthHelper.php';
+require_once dirname(__DIR__) . '/helpers/Database.php';
+require_once dirname(__DIR__) . '/models/VehicleOwner.php';
+require_once dirname(__DIR__) . '/models/DriverOwnerLink.php';
+require_once dirname(__DIR__) . '/models/Driver.php';
+
+/**
+ * Lanka Renters - Owner Driver Controller
+ * Manages driver connections and requests for the authenticated vehicle owner.
+ * All queries enforce ownership via session-resolved owner_id — never from client input.
+ */
+class OwnerDriverController {
+    private $db;
+    private $ownerModel;
+    private $linkModel;
+    private $driverModel;
+
+    public function __construct() {
+        $this->db          = Database::getInstance()->getConnection();
+        $this->ownerModel  = new VehicleOwner();
+        $this->linkModel   = new DriverOwnerLink();
+        $this->driverModel = new Driver();
+    }
+
+    /**
+     * Resolves authenticated owner profile from session.
+     */
+    private function getAuthenticatedOwner(): array {
+        AuthHelper::requireRole('owner');
+        $user = AuthHelper::getCurrentUser();
+        if (!$user) {
+            throw new Exception('Unauthorized access.');
+        }
+        $owner = $this->ownerModel->findByUserId($user['id']);
+        if (!$owner) {
+            throw new Exception('Vehicle owner profile not found.');
+        }
+        return ['user' => $user, 'owner' => $owner];
+    }
+
+    /**
+     * Fetches all accepted drivers linked to the authenticated owner,
+     * all pending outbound requests, and all available verified drivers for discovery.
+     */
+    public function getDriverData(): array {
+        try {
+            $auth    = $this->getAuthenticatedOwner();
+            $ownerId = $auth['owner']['id'];
+
+            // Accepted drivers
+            $acceptedDrivers = $this->linkModel->getAcceptedDriversByOwner($ownerId);
+
+            // Pending outbound requests
+            $stmtPending = $this->db->prepare("
+                SELECT dol.id AS link_id, dol.created_at,
+                       d.rating_avg AS rating,
+                       u.name, u.email, u.phone
+                FROM driver_owner_links dol
+                JOIN drivers d ON dol.driver_id = d.id
+                JOIN users   u ON d.user_id     = u.id
+                WHERE dol.owner_id = :owner_id AND dol.status = 'pending'
+                ORDER BY dol.created_at DESC
+            ");
+            $stmtPending->execute(['owner_id' => $ownerId]);
+            $pendingRequests = $stmtPending->fetchAll(PDO::FETCH_ASSOC);
+
+            // Available verified drivers (for discovery/request form)
+            $availableDrivers = $this->driverModel->getAvailableVerifiedDrivers();
+
+            return [
+                'success'          => true,
+                'owner'            => $auth['owner'],
+                'accepted_drivers' => $acceptedDrivers,
+                'pending_requests' => $pendingRequests,
+                'available_drivers' => $availableDrivers,
+            ];
+        } catch (Exception $e) {
+            return [
+                'success' => false,
+                'error'   => $e->getMessage(),
+                'accepted_drivers'  => [],
+                'pending_requests'  => [],
+                'available_drivers' => [],
+            ];
+        }
+    }
+
+    /**
+     * Sends a connection request from the authenticated owner to a driver.
+     * Validates CSRF, checks driver eligibility, and prevents duplicate requests.
+     *
+     * @param array $postData POST input containing driver_id and csrf_token
+     */
+    public function requestDriverConnection(array $postData): array {
+        try {
+            $auth    = $this->getAuthenticatedOwner();
+            $ownerId = $auth['owner']['id'];
+
+            // 1. CSRF
+            if (!AuthHelper::validateCsrfToken($postData['csrf_token'] ?? '')) {
+                return ['success' => false, 'error' => 'CSRF security verification failed.'];
+            }
+
+            $driverId = (int)($postData['driver_id'] ?? 0);
+            if ($driverId <= 0) {
+                return ['success' => false, 'error' => 'Invalid driver selected.'];
+            }
+
+            // 2. Validate the driver is eligible (verified + available)
+            $availableDrivers = $this->driverModel->getAvailableVerifiedDrivers();
+            $isEligible       = false;
+            foreach ($availableDrivers as $d) {
+                if ((int)$d['id'] === $driverId) {
+                    $isEligible = true;
+                    break;
+                }
+            }
+            if (!$isEligible) {
+                return ['success' => false, 'error' => 'Selected driver is not eligible or verified.'];
+            }
+
+            // 3. Check for existing link
+            $stmt = $this->db->prepare("SELECT status FROM driver_owner_links WHERE driver_id = :did AND owner_id = :oid LIMIT 1");
+            $stmt->execute(['did' => $driverId, 'oid' => $ownerId]);
+            $existing = $stmt->fetchColumn();
+
+            if ($existing === 'accepted') {
+                return ['success' => false, 'error' => 'You are already connected with this driver.'];
+            }
+            if ($existing === 'pending') {
+                return ['success' => false, 'error' => 'A connection request is already pending with this driver.'];
+            }
+
+            // 4. Create the link
+            $this->linkModel->requestLink($driverId, $ownerId);
+            return ['success' => true, 'message' => 'Connection request sent successfully.'];
+
+        } catch (Exception $e) {
+            return ['success' => false, 'error' => 'Request failed: ' . $e->getMessage()];
+        }
+    }
+}
diff --git a/app/controllers/OwnerEarningsController.php b/app/controllers/OwnerEarningsController.php
new file mode 100644
index 0000000..4ed97cd
--- /dev/null
+++ b/app/controllers/OwnerEarningsController.php
@@ -0,0 +1,95 @@
+<?php
+
+require_once dirname(__DIR__) . '/helpers/AuthHelper.php';
+require_once dirname(__DIR__) . '/helpers/Database.php';
+require_once dirname(__DIR__) . '/models/VehicleOwner.php';
+
+/**
+ * Lanka Renters - Owner Earnings Controller
+ * Aggregates payment and booking revenue data for the authenticated vehicle owner.
+ * All queries enforce ownership via session-resolved owner_id.
+ */
+class OwnerEarningsController {
+    private $db;
+    private $ownerModel;
+
+    public function __construct() {
+        $this->db         = Database::getInstance()->getConnection();
+        $this->ownerModel = new VehicleOwner();
+    }
+
+    /**
+     * Resolves authenticated owner profile from session.
+     */
+    private function getAuthenticatedOwner(): array {
+        AuthHelper::requireRole('owner');
+        $user = AuthHelper::getCurrentUser();
+        if (!$user) {
+            throw new Exception('Unauthorized access.');
+        }
+        $owner = $this->ownerModel->findByUserId($user['id']);
+        if (!$owner) {
+            throw new Exception('Vehicle owner profile not found.');
+        }
+        return ['user' => $user, 'owner' => $owner];
+    }
+
+    /**
+     * Returns earnings summary and per-vehicle breakdown.
+     */
+    public function getEarningsSummary(): array {
+        try {
+            $auth    = $this->getAuthenticatedOwner();
+            $ownerId = $auth['owner']['id'];
+
+            // Overall earnings from completed bookings
+            $stmtTotal = $this->db->prepare("
+                SELECT
+                    COALESCE(SUM(CASE WHEN b.status = 'completed'
+                                      AND EXISTS (SELECT 1 FROM payments p WHERE p.booking_id = b.id AND p.payment_status = 'completed')
+                                      AND NOT EXISTS (SELECT 1 FROM payments p WHERE p.booking_id = b.id AND p.payment_status = 'refunded')
+                                      THEN b.total_price ELSE 0 END), 0) AS total_completed,
+                    COALESCE(SUM(CASE WHEN b.status IN ('confirmed','ongoing') THEN b.total_price ELSE 0 END), 0) AS total_pending
+                FROM bookings b
+                JOIN vehicles v ON b.vehicle_id = v.id
+                WHERE v.owner_id = :owner_id
+            ");
+            $stmtTotal->execute(['owner_id' => $ownerId]);
+            $totals = $stmtTotal->fetch(PDO::FETCH_ASSOC);
+
+            // Per-vehicle breakdown
+            $stmtVehicle = $this->db->prepare("
+                SELECT
+                    v.id,
+                    v.make,
+                    v.model,
+                    v.license_plate,
+                    COALESCE(SUM(CASE WHEN b.status = 'completed'
+                                   AND EXISTS (SELECT 1 FROM payments p WHERE p.booking_id = b.id AND p.payment_status = 'completed')
+                                   AND NOT EXISTS (SELECT 1 FROM payments p WHERE p.booking_id = b.id AND p.payment_status = 'refunded')
+                                   THEN b.total_price ELSE 0 END), 0) AS earned,
+                    COUNT(CASE WHEN b.status = 'completed'
+                                 AND EXISTS (SELECT 1 FROM payments p WHERE p.booking_id = b.id AND p.payment_status = 'completed')
+                                 AND NOT EXISTS (SELECT 1 FROM payments p WHERE p.booking_id = b.id AND p.payment_status = 'refunded')
+                             THEN 1 END) AS trips
+                FROM vehicles v
+                LEFT JOIN bookings b ON b.vehicle_id = v.id
+                WHERE v.owner_id = :owner_id
+                GROUP BY v.id, v.make, v.model, v.license_plate
+                ORDER BY earned DESC
+            ");
+            $stmtVehicle->execute(['owner_id' => $ownerId]);
+            $vehicleBreakdown = $stmtVehicle->fetchAll(PDO::FETCH_ASSOC);
+
+            return [
+                'success'          => true,
+                'total_completed'  => (float)($totals['total_completed'] ?? 0),
+                'total_pending'    => (float)($totals['total_pending'] ?? 0),
+                'vehicle_breakdown' => $vehicleBreakdown,
+                'owner'            => $auth['owner'],
+            ];
+        } catch (Exception $e) {
+            return ['success' => false, 'error' => $e->getMessage()];
+        }
+    }
+}
