+        } elseif ($action === 'reject') {
+            $reason = trim($_POST['rejection_reason'] ?? 'Declined by administrative review.');
+            $result = $controller->rejectAccountChange($requestId, $reason);
+            if ($result['success']) {
+                $success = $result['message'];
+            } else {
+                $error = $result['error'];
+            }
+        }
+    }
+}
