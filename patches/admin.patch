+    $pdf->text('Generated: ' . date('Y-m-d H:i:s'), 36, 752, 9);
+    $pdf->text('Report period: ' . ($from !== '' ? $from : 'Beginning') . ' to ' . ($to !== '' ? $to : 'Today'), 36, 736, 9);
+    $pdf->heading('Platform Activity Summary');
+    $pdf->row(['Booking status', 'Total bookings'], [260, 160]);
