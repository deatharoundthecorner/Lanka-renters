+}
+
+.profile-info-sm,
+.lr-sidebar-account-copy {
+    display: flex;
+    flex-direction: column;
+    min-width: 0;
+}
+
+.profile-info-sm h4,
+.lr-sidebar-account-name {
+    font-size: 13px;
+    font-weight: 600;
+    color: var(--text-main);
+    line-height: 1.2;
