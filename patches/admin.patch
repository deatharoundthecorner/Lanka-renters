+    max-width: 720px;
+    margin: 0;
+    color: var(--lr-text-muted);
+    font-size: 14px;
+}
+
+.admin-layout .card,
+.admin-layout .form-card,
+.admin-layout .stat-card,
+.admin-layout .queue-card {
+    border-color: var(--lr-border);
+    border-radius: var(--lr-radius-lg);
+    box-shadow: var(--lr-shadow-sm);
+}
+
+.admin-layout table th,
+.admin-layout table td {
+    border-color: var(--lr-border);
+}
+
+@media (max-width: 768px) {
+    .admin-layout > .sidebar {
+        transform: translateX(-100%);
+        transition: transform 180ms ease;
+    }
+
+    .admin-layout > .sidebar.mobile-open {
+        transform: translateX(0);
+        box-shadow: 12px 0 30px rgba(11, 18, 32, 0.12);
+    }
+
+    .admin-layout .main-wrapper {
+        margin-left: 0;
+    }
+
+    .admin-layout .top-header {
+        left: 0;
+        padding: 0 16px;
+    }
+
+    .admin-layout .mobile-nav-toggle {
+        display: inline-flex;
+    }
+
+    .admin-layout .page-container {
+        padding: calc(var(--lr-header-height) + 22px) 16px 36px;
+    }
+
+    .admin-layout .grid-2,
+    .admin-layout .grid-4 {
+        grid-template-columns: minmax(0, 1fr) !important;
+    }
+
+    .admin-revenue-header {
+        flex-direction: column;
+    }
+
+    .admin-revenue-summary {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+
+    .admin-chart-wrap,
+    .admin-layout #monthlyPaymentChart {
+        height: 250px !important;
+    }
+
+    .admin-layout .breadcrumb span:first-child,
+    .admin-layout .breadcrumb svg {
+        display: none;
+    }
+
+    .admin-layout .user-name-role {
+        display: none;
+    }
+}
+
+@media (min-width: 769px) and (max-width: 1024px) {
+    .admin-layout .grid-4 {
+        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
+    }
+}
